{
  "name": "@evo/simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:determinism": "vitest run --config vitest.determinism.config.ts"
  },
  "dependencies": {
    "@evo/contracts": "workspace:*",
    "@evo/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
